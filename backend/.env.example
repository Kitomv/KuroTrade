# User account creation (manual — registration is disabled).
# Copy this file to `.env` and fill in a new account, then restart the backend.
# Runs on boot: creates the user only if the username is not already taken.

USER_USERNAME=namauserbaru
USER_PASSWORD=password12345

# Legacy names are also accepted:
# ADMIN_USER=admin
# ADMIN_PASSWORD=admin123

# --- Hot Wallet (backend auto-execution for 24/7 autopilot) ---
# Master encryption key for AES-256-GCM keystores. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat like a database password — it decrypts every user's hot-wallet key.
MASTER_ENCRYPTION_KEY=

# Solana RPC for the hot-wallet executor. Public mainnet works but rate-limits
# autopilot. Prefer a private/paid RPC (Helius, QuickNode, Shyft).
# BACKEND_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Hard USD ceiling per automated swap (rejects oversized trades).
# HOT_WALLET_MAX_USD_PER_TRADE=50

# Jupiter API base + optional API key (paid plan).
# JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=