# --- Account creation (optional) ---
# Creates a username/password account on boot, if the username is not already
# taken. Not required: signing in with MetaMask creates an account on first use.
# Copy this file to `.env` and fill in a new account, then restart the backend.
USER_USERNAME=namauserbaru
USER_PASSWORD=password12345

# Legacy aliases, still accepted:
# ADMIN_USER=admin
# ADMIN_PASSWORD=admin123

# --- Real swaps (required for anything on-chain) ---
# The backend calls 1inch with this key; it never ships to the browser.
# Free tier: https://portal.1inch.dev
INCH_API_KEY=

# 1inch Aggregation Router v6. CREATE2-deployed at the SAME address on every
# supported chain, so this is one constant rather than a per-chain map.
# The swap path refuses any tx aimed elsewhere — a wrong value fails CLOSED
# (every swap is rejected) rather than approving an unknown contract.
# Only set this if 1inch rotates the router.
# ONE_INCH_ROUTER=0x111111125421cA6dc452d289314280a0f8842A65

# --- LLM providers (optional) ---
# Only needed to run the Bull/Bear/Lead agents. Without a key the engine falls
# back to the deterministic scoring path. Prefer configuring providers per-user
# in Settings → LLM; this env value only seeds the default stack.
# ROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Risk limits ---
# Hard USD ceiling per automated swap. Clamps every autopilot-sized buy; the
# per-user risk level sets the target and this env sets the ceiling.
# HOT_WALLET_MAX_USD_PER_TRADE=50

# --- Chain RPC endpoints (optional) ---
# Public endpoints work but rate-limit; point these at a private RPC for
# reliable autopilot. Each falls back to the public default when unset.
# BACKEND_BASE_RPC=https://mainnet.base.org
# BACKEND_ETH_RPC=https://eth.llamarpc.com
# BACKEND_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# BACKEND_BSC_RPC=https://bsc-dataseed.bnbchain.org
# BACKEND_OPTIMISM_RPC=https://mainnet.optimism.io
# BACKEND_POLYGON_RPC=https://polygon-rpc.com
# BACKEND_AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc

# --- Server ---
# PORT=3001

# --- Tests only ---
# Redirects per-user JSON state to a temp dir so `npm test` never touches
# backend/data. Leave unset in production.
# PERSIST_DATA_DIR=
